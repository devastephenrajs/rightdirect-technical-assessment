---
interface StatItem {
  value: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  stats: StatItem[];
}

const {
  title,
  description,
  stats = []
} = Astro.props;
---

<section class="stats-section">
  <div class="container stats-grid">
    <div class="stats-intro">
      <h2>{title}</h2>

      <p>{description}</p>
    </div>

    {stats.map((stat) => (
      <div class="stat-card">
        <h3>{stat.value}</h3>
        <p>{stat.label}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .stats-section {
    background: #eef1f4;
    padding: 55px 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1.3fr repeat(3, 1fr);
    gap: 18px;
    align-items: stretch;
  }

  .stats-intro {
    padding: 10px 10px 10px 0;
  }

  .stats-intro h2 {
    color: var(--primary);
    font-size: 38px;
    line-height: 1.08;
    font-weight: 500;
    max-width: 250px;
  }

  .stats-intro p {
    margin-top: 18px;
    max-width: 280px;
    color: #333;
    font-size: 16px;
    line-height: 1.6;
  }

  .stat-card {
    min-height: 170px;
    background: white;
    border-radius: 14px;
    padding: 28px 20px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.04);
  }

  .stat-card h3 {
    color: var(--primary);
    font-size: 54px;
    line-height: 1;
    font-weight: 600;
  }

  .stat-card p {
    margin-top: 12px;
    color: #4d5966;
    font-size: 15px;
  }

  @media (max-width: 950px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stats-intro {
      padding-right: 0;
    }

    .stats-intro h2 {
      max-width: none;
    }

    .stats-intro p {
      max-width: none;
    }
  }

  @media (max-width: 600px) {
    .stats-section {
      padding: 45px 0;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .stats-intro {
      text-align: center;
      padding-bottom: 15px;
    }

    .stats-intro h2 {
      font-size: 32px;
    }

    .stat-card {
      min-height: 145px;
    }

    .stat-card h3 {
      font-size: 46px;
    }
  }
</style>