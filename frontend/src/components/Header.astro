---
interface NavItem {
  label: string;
  url: string;
}

interface Props {
  navigation: NavItem[];
  ctaText: string;
  ctaUrl: string;
}

const {
  navigation = [],
  ctaText,
  ctaUrl
} = Astro.props;
---

<header class="site-header">
  <div class="nav-shell container">
    <a href="/" class="logo" aria-label="RightDirect Home">
      <span class="logo-right">Right</span><span class="logo-direct">Direct</span>
      <span class="logo-mark">»</span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {navigation.map((item) => (
        <a href={item.url}>
          {item.label}
        </a>
      ))}
    </nav>

    {ctaText && ctaUrl && (
      <a href={ctaUrl} class="get-started">
        {ctaText}
        <span>→</span>
      </a>
    )}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 20px;
    z-index: 1000;
    padding-top: 18px;
  }

  .nav-shell {
    min-height: 68px;
    display: flex;
    align-items: center;
    gap: 24px;

    background: rgba(255, 255, 255, 0.96);
    border-radius: 24px;
    padding: 10px 18px;

    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
  }

  .logo {
    display: flex;
    align-items: center;
    white-space: nowrap;
    font-size: 29px;
    line-height: 1;
  }

  .logo-right {
    color: var(--primary);
  }

  .logo-direct {
    color: #9a9a9a;
  }

  .logo-mark {
    margin-left: 5px;
    color: var(--primary);
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -8px;
    transform: translateY(-1px);
  }

  .nav-links {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
  }

  .nav-links a {
    padding: 9px 12px;
    border-radius: 999px;
    font-size: 14px;
    white-space: nowrap;
    transition: 0.2s ease;
  }

  .nav-links a:hover {
    background: #eef4f8;
    color: var(--primary);
  }

  .get-started {
    display: inline-flex;
    align-items: center;
    gap: 22px;

    background: var(--primary);
    color: white;

    padding: 11px 22px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;

    white-space: nowrap;
    transition: 0.25s ease;
  }

  .get-started:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
  }

  @media (max-width: 1050px) {
    .nav-links {
      display: none;
    }

    .nav-shell {
      justify-content: space-between;
    }
  }

  @media (max-width: 600px) {
    .site-header {
      top: 10px;
      padding-top: 10px;
    }

    .nav-shell {
      min-height: 60px;
      border-radius: 18px;
    }

    .logo {
      font-size: 23px;
    }

    .logo-mark {
      font-size: 29px;
    }

    .get-started {
      padding: 10px 15px;
      gap: 10px;
      font-size: 12px;
    }
  }
</style>