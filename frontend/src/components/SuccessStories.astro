---
interface SuccessStory {
  client: string;
  category: string;
  title: string;
  description: string;
  ctaText?: string;
  ctaUrl?: string;
  image?: {
    url?: string;
    alt?: string;
  };
}

interface Props {
  title: string;
  description: string;
  stories?: SuccessStory[];
  moreTitle?: string;
  moreDescription?: string;
  moreCtaText?: string;
  moreCtaUrl?: string;
}

const {
  title,
  description,
  stories = [],
  moreTitle,
  moreDescription,
  moreCtaText,
  moreCtaUrl
} = Astro.props;
---

<section class="success-section" id="success">
  <div class="container">
    <div class="success-heading">
      <h2>{title}</h2>
      <p>{description}</p>
    </div>

    <div class="success-grid">
      {stories.map((story) => (
        <article class="success-card">
          <div class="story-meta">
            <span>{story.category}</span>
            <h3>{story.client}</h3>
          </div>

          {story.image?.url && (
            <img
              src={story.image.url}
              alt={story.image.alt || ""}
              loading="lazy"
            />
          )}

          <div class="story-content">
            <h4>{story.title}</h4>
            <p>{story.description}</p>

            {story.ctaText && story.ctaUrl && (
              <a href={story.ctaUrl} class="story-link">
                {story.ctaText}
                <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </article>
      ))}

      {(moreTitle || moreCtaText) && (
        <article class="more-card">
          <div>
            <p class="more-label">More Success Stories</p>

            {moreTitle && <h3>{moreTitle}</h3>}

            {moreDescription && <p>{moreDescription}</p>}
          </div>

          {moreCtaText && moreCtaUrl && (
            <a href={moreCtaUrl}>
              {moreCtaText}
              <span aria-hidden="true">→</span>
            </a>
          )}
        </article>
      )}
    </div>
  </div>
</section>

<style>
  .success-section {
    padding: 80px 0;
    background: #f5f7f9;
  }

  .success-heading {
    max-width: 850px;
    margin: 0 auto 55px;
    text-align: center;
  }

  .success-heading h2 {
    color: var(--primary);
    font-size: 38px;
    font-weight: 500;
    line-height: 1.2;
  }

  .success-heading p {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.7;
    color: #333333;
  }

  .success-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .success-card,
  .more-card {
    border-radius: 14px;
    overflow: hidden;
  }

  .success-card {
    background: #ffffff;
    border: 1px solid #e1e6eb;
  }

  .story-meta {
    padding: 22px 22px 14px;
  }

  .story-meta span {
    color: var(--primary);
    font-size: 13px;
  }

  .story-meta h3 {
    margin-top: 4px;
    color: var(--primary);
    font-size: 21px;
    font-weight: 500;
  }

  .success-card img {
    width: calc(100% - 44px);
    height: 180px;
    margin: 0 22px;
    object-fit: cover;
    border-radius: 8px;
  }

  .story-content {
    padding: 22px;
  }

  .story-content h4 {
    color: var(--primary);
    font-size: 20px;
    line-height: 1.3;
    font-weight: 500;
  }

  .story-content p {
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.6;
    color: #333333;
  }

  .story-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    margin-top: 22px;
    padding: 8px 16px;

    border: 1px solid var(--primary);
    border-radius: 999px;

    color: var(--primary);
    font-weight: 600;
  }

  .more-card {
    min-height: 420px;
    padding: 30px;
    background: var(--primary);
    color: #ffffff;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .more-label {
    font-size: 14px;
  }

  .more-card h3 {
    margin-top: 15px;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 500;
  }

  .more-card > div > p:not(.more-label) {
    margin-top: 15px;
    line-height: 1.6;
  }

  .more-card a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #ffffff;
    font-weight: 600;
  }

  @media (max-width: 950px) {
    .success-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .success-section {
      padding: 60px 0;
    }

    .success-heading h2 {
      font-size: 30px;
    }

    .success-grid {
      grid-template-columns: 1fr;
    }
  }
</style>