---
interface Props {
  title: string;
  description: string;
  ctaText: string;
  ctaUrl: string;
}

const {
  title,
  description,
  ctaText,
  ctaUrl
} = Astro.props;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-content">
      <h1>{title}</h1>

      <p>{description}</p>

      {ctaText && ctaUrl && (
        <a href={ctaUrl} class="btn-primary">
          {ctaText}
          <span>→</span>
        </a>
      )}
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="shape shape-main"></div>
      <div class="shape shape-inner"></div>
      <div class="shape shape-top"></div>
      <div class="shape shape-bottom"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 95px 0 85px;
    background: #fff;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
  }

  .hero-content h1 {
    max-width: 650px;
    color: var(--primary);
    font-size: clamp(42px, 5vw, 68px);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -1.5px;
  }

  .hero-content p {
    max-width: 700px;
    margin: 26px 0 30px;
    font-size: 18px;
    line-height: 1.7;
    color: #202020;
  }

  .hero-visual {
    position: relative;
    min-height: 430px;
  }

  .shape {
    position: absolute;
    border-radius: 22px;
  }

  .shape-main {
    width: 290px;
    height: 330px;
    right: 45px;
    top: 60px;
    background: #e8eef3;
  }

  .shape-inner {
    width: 250px;
    height: 280px;
    right: 75px;
    top: 90px;
    background: #dce4eb;
  }

  .shape-top {
    width: 150px;
    height: 150px;
    right: 10px;
    top: 0;
    background: #adadad;
  }

  .shape-bottom {
    width: 150px;
    height: 150px;
    left: 10px;
    bottom: 0;
    background: #4c83b1;
  }

  @media (max-width: 950px) {
    .hero {
      padding-top: 70px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .hero-visual {
      min-height: 350px;
      max-width: 500px;
      width: 100%;
      margin-inline: auto;
    }

    .shape-main {
      width: 260px;
      height: 290px;
    }

    .shape-inner {
      width: 220px;
      height: 245px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 60px 0;
    }

    .hero-content h1 {
      font-size: 42px;
    }

    .hero-content p {
      font-size: 16px;
    }

    .hero-visual {
      min-height: 300px;
    }

    .shape-main {
      width: 210px;
      height: 240px;
      right: 20px;
    }

    .shape-inner {
      width: 180px;
      height: 200px;
      right: 45px;
    }

    .shape-top,
    .shape-bottom {
      width: 110px;
      height: 110px;
    }
  }
</style>