---
interface Testimonial {
  name: string;
  role?: string;
  company?: string;
  quote: string;
  image?: {
    url?: string;
    alt?: string;
  };
}

interface Props {
  title: string;
  testimonials?: Testimonial[];
}

const {
  title,
  testimonials = []
} = Astro.props;
---

<section class="testimonials-section">
  <div class="container">
    <div class="testimonials-heading">
      <h2>{title}</h2>
    </div>

    <div class="testimonial-slider" data-testimonial-slider>
      <div class="testimonial-stage">
        {testimonials?.map((item, index) => (
          <article
            class:list={[
              "testimonial-slide",
              { active: index === 0 }
            ]}
            data-slide={index}
          >
            <div class="person-image">
              {item.image?.url && (
                <img
                  src={item.image.url}
                  alt={item.image.alt || item.name}
                  loading="lazy"
                />
              )}
            </div>

            <div class="testimonial-content">
              {item.company && (
                <p class="company">{item.company}</p>
              )}

              <blockquote>
                “{item.quote}”
              </blockquote>

              <h3>{item.name}</h3>

              {item.role && (
                <p class="role">{item.role}</p>
              )}
            </div>
          </article>
        ))}
      </div>

      {testimonials.length > 1 && (
        <div class="testimonial-dots" aria-label="Testimonial navigation">
          {testimonials.map((_, index) => (
            <button
              type="button"
              class:list={[
                "dot",
                { active: index === 0 }
              ]}
              data-dot={index}
              aria-label={`Show testimonial ${index + 1}`}
            ></button>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    padding: 85px 0 75px;
    background: #f4f6f8;
  }

  .testimonials-heading {
    text-align: center;
    margin-bottom: 60px;
  }

  .testimonials-heading h2 {
    color: var(--primary);
    font-size: 38px;
    font-weight: 500;
    line-height: 1.2;
  }

  .testimonial-slider {
    max-width: 820px;
    margin: 0 auto;
  }

  .testimonial-stage {
    position: relative;
    min-height: 340px;
  }

  .testimonial-slide {
    position: absolute;
    inset: 0;

    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 30px;
    align-items: start;

    opacity: 0;
    visibility: hidden;
    transform: translateX(25px);

    transition:
      opacity 0.6s ease,
      transform 0.6s ease,
      visibility 0.6s ease;
  }

  .testimonial-slide.active {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  .person-image {
    display: flex;
    justify-content: center;
  }

  .person-image img {
    width: 94px;
    height: 94px;
    border-radius: 50%;
    object-fit: cover;
  }

  .company {
    margin-bottom: 22px;
    color: var(--primary);
    font-size: 13px;
    letter-spacing: 1px;
  }

  blockquote {
    margin: 0;
    color: #202020;
    font-size: 16px;
    line-height: 1.75;
  }

  .testimonial-content h3 {
    margin-top: 28px;
    color: #111111;
    font-size: 19px;
    font-weight: 500;
  }

  .role {
    margin-top: 2px;
    color: #444444;
    font-size: 14px;
  }

  .testimonial-dots {
    margin-top: 30px;

    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }

  .dot {
    width: 9px;
    height: 9px;
    padding: 0;

    border: none;
    border-radius: 999px;

    background: #c7d4df;
    cursor: pointer;

    transition:
      width 0.3s ease,
      background 0.3s ease;
  }

  .dot.active {
    width: 28px;
    background: var(--primary);
  }

  @media (max-width: 700px) {
    .testimonial-stage {
      min-height: 500px;
    }

    .testimonial-slide {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 20px;
    }

    .testimonial-content h3 {
      margin-top: 22px;
    }
  }
</style>

<script>
  const sliders = document.querySelectorAll("[data-testimonial-slider]");

  sliders.forEach((slider) => {
    const slides = slider.querySelectorAll("[data-slide]");
    const dots = slider.querySelectorAll("[data-dot]");

    if (slides.length <= 1) return;

    let current = 0;
    let interval;

    const showSlide = (index) => {
      slides.forEach((slide) => slide.classList.remove("active"));
      dots.forEach((dot) => dot.classList.remove("active"));

      slides[index]?.classList.add("active");
      dots[index]?.classList.add("active");

      current = index;
    };

    const nextSlide = () => {
      const next = (current + 1) % slides.length;
      showSlide(next);
    };

    const startAutoPlay = () => {
      clearInterval(interval);
      interval = setInterval(nextSlide, 4000);
    };

    const stopAutoPlay = () => {
      clearInterval(interval);
    };

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        showSlide(index);
        startAutoPlay();
      });
    });

    slider.addEventListener("mouseenter", stopAutoPlay);
    slider.addEventListener("mouseleave", startAutoPlay);

    startAutoPlay();
  });
</script>